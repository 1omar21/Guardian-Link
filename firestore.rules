rules_version = '2';

// GuardianLink: the mobile app never talks to Firestore directly.
// All reads and writes go through the FastAPI backend, which uses the
// Firebase Admin SDK (the Admin SDK bypasses these rules).
// So every direct client access is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
